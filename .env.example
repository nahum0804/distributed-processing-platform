# Redis
REDIS_HOST=192.168.1.X
REDIS_PORT=6379
REDIS_PASSWORD=

# Coordinador
COORDINATOR_URL=http://192.168.1.X:8000

# MinIO
MINIO_ENDPOINT=192.168.1.X:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
DATASET_BUCKET=dataset
RESULTS_BUCKET=results

# Identidad del worker
# WORKER_ID vacio: se genera como "worker-<hostname>"
WORKER_ID=
WORKER_QUEUES=transcode_video,extract_audio,generate_thumbnail,convert_audio,extract_metadata
WORKER_CONCURRENCY=2
WORK_DIR=/tmp/mm-worker
# FFMPEG_TIMEOUT vacio: sin limite de tiempo por trabajo de ffmpeg
FFMPEG_TIMEOUT=

# Reaper (recuperacion de sub-tareas colgadas)
HEARTBEAT_INTERVAL=5.0
HEARTBEAT_TTL=15
REAPER_INTERVAL=10.0
REAPER_MAX_AGE=2100.0
MAX_ATTEMPTS=3
