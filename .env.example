# Redis
REDIS_HOST=192.168.1.X
REDIS_PORT=6379
REDIS_PASSWORD=

# Coordinador
COORDINATOR_URL=http://192.168.1.X:8000

# MinIO
MINIO_ENDPOINT=192.168.1.X:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
DATASET_BUCKET=dataset
RESULTS_BUCKET=results
# Imagen del servidor MinIO (solo maquina A). Vacio: cgr.dev/chainguard/minio:latest
MINIO_IMAGE=

# Identidad del worker
# NODE_NAME: nombre de la maquina fisica (ej. kenni-laptop). En Docker el hostname es el id
# del contenedor, asi que esto es lo que aparece como "host" en reportes y dashboard.
NODE_NAME=
# WORKER_ID vacio: se genera como "worker-<hostname>" (unico por contenedor; necesario con --scale)
WORKER_ID=
WORKER_QUEUES=transcode_video,extract_audio,generate_thumbnail,convert_audio,extract_metadata
WORKER_CONCURRENCY=2
# WORK_DIR vacio: carpeta temporal del sistema (la imagen Docker usa /tmp/mm-worker)
WORK_DIR=
# FFMPEG_TIMEOUT vacio: rige el default del procesador (600 s; proporcional a la duracion en P2)
FFMPEG_TIMEOUT=

# Reaper (recuperacion de sub-tareas colgadas)
HEARTBEAT_INTERVAL=5.0
HEARTBEAT_TTL=15
REAPER_INTERVAL=10.0
REAPER_MAX_AGE=2100.0
MAX_ATTEMPTS=3
